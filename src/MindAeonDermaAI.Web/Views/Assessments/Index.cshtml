@model List<AssessmentListRow>
@{
    ViewData["Title"] = "Assessments";
}
<div class="page-head">
    <h1>Assessments</h1>
    <div class="spacer"></div>
    <a class="btn btn-ghost" asp-action="Compare">Before / After</a>
    <a class="btn btn-ghost" asp-action="Example">View example report</a>
    <a class="btn btn-dark" asp-action="Scan">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3"/><circle cx="12" cy="12" r="3"/></svg>
        Live Skin Scan
    </a>
    <a class="btn btn-primary" asp-action="Create">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New assessment
    </a>
</div>

<div class="card">
    <div class="card-b" style="padding:0">
        @if (Model.Count == 0)
        {
            <div class="empty">
                <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4z"/><path d="M8 10h8M8 14h5"/></svg>
                <p class="mt-2">No assessments yet.</p>
                <a class="btn btn-primary btn-sm" asp-action="Create">Create the first assessment</a>
            </div>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Subject</th><th>Timepoint</th><th>Status</th><th>Panel</th><th class="num">Score</th><th>Date</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.SubjectCode</strong>@(string.IsNullOrEmpty(r.SubjectName) ? "" : $" · {r.SubjectName}")</td>
                        <td>@r.TimePoint</td>
                        <td><span class="badge badge-navy">@r.Status</span></td>
                        <td>@(r.Panel ?? "—")</td>
                        <td class="num">@(r.Score.HasValue ? r.Score.Value.ToString("0") : "—")</td>
                        <td class="muted">@r.Created.ToString("yyyy-MM-dd")</td>
                        <td class="flex gap-2">
                            <a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@r.Id">Open</a>
                            @if (r.Score.HasValue)
                            {
                                <a class="btn btn-dark btn-sm" asp-action="Report" asp-route-id="@r.Id">Report</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
