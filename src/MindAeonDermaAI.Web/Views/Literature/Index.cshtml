@using MindAeonDermaAI.Web.Controllers
@model List<LiteratureRow>
@{
    ViewData["Title"] = "Literature & evidence";
    // Group by domain so each biological area reads as one section.
    var groups = Model.GroupBy(r => r.DomainName).ToList();
}

<div class="page-head">
    <div>
        <h1 style="margin-bottom:2px">Literature &amp; evidence</h1>
        <div class="muted">Curated, non-diagnostic scientific background for each biomarker.</div>
    </div>
    <div class="spacer"></div>
    <span class="badge badge-muted">@Model.Count biomarkers</span>
</div>

<div class="card mb-3">
    <div class="card-b">
        <p class="mt-0">
            Each entry summarizes the established role of a biomarker in skin biology — its mechanism, what a
            comparatively lower or higher signal tends to indicate, and its relevance to aging, barrier and collagen
            remodeling. These are educational summaries only; the references are representative of well-known
            dermatology and skin-biology literature and are not exhaustive citations.
        </p>
        <div class="tag-list">
            @foreach (var g in groups)
            {
                <span class="chip">@g.Key · @g.Count()</span>
            }
        </div>
    </div>
</div>

@foreach (var g in groups)
{
    <div class="page-head" style="margin-bottom:12px">
        <h1 style="font-size:18px">@g.Key</h1>
        <div class="spacer"></div>
        <span class="badge badge-navy">Domain</span>
    </div>

    <div class="grid cols-2 mb-3">
        @foreach (var row in g)
        {
            var ev = row.Evidence!;
            <div class="card">
                <div class="card-h">
                    <h3>@row.BiomarkerName</h3>
                    <div class="spacer" style="flex:1"></div>
                    <span class="badge badge-teal">@row.DomainName</span>
                </div>
                <div class="card-b">
                    <div class="muted mb-2" style="font-size:11.5px;text-transform:uppercase;letter-spacing:.04em">@ev.Title</div>
                    <p class="mt-0">@ev.WhyItMatters</p>
                    <div class="mt-3">
                        <div class="muted mb-2" style="font-size:11.5px;text-transform:uppercase;letter-spacing:.04em">Representative literature</div>
                        <div class="tag-list">
                            @foreach (var reference in ev.References)
                            {
                                <span class="chip">@reference</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card">
    <div class="card-b">
        <div class="disclaimer">
            Research use only. The content on this page is a curated, non-diagnostic educational summary of published
            skin-biology mechanisms. References are representative of well-established literature and are not intended as
            precise or complete citations. Nothing here is a medical diagnosis or a treatment recommendation.
        </div>
    </div>
</div>
