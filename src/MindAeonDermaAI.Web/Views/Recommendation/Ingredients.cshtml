@using MindAeonDermaAI.Web.Controllers
@model InciVm
@{
    ViewData["Title"] = "INCI suitability check";

    string BadgeClass(string verdict) => verdict switch
    {
        "Beneficial" => "badge badge-ok",
        "Caution" => "badge badge-warn",
        _ => "badge badge-muted"
    };
}

<div class="page-head">
    <div>
        <h1 style="margin-bottom:2px">Product INCI suitability</h1>
        <div class="muted">
            Subject @Model.Subject?.Code · Assessment #@Model.Assessment.Id ·
            Integrated score @(Model.Score?.IntegratedSkinQualityScore.ToString("0"))/100 · Research use
        </div>
    </div>
    <div class="spacer"></div>
    <a class="btn btn-ghost" asp-action="Index" asp-route-id="@Model.Assessment.Id">Recommendations</a>
    <a class="btn btn-ghost" asp-controller="Assessments" asp-action="Details" asp-route-id="@Model.Assessment.Id">Back</a>
</div>

<div class="alert alert-info">
    <strong>Cosmetic education only.</strong> Paste a product's INCI (ingredient) list to see how each recognized
    ingredient fits this assessment's biology profile. Non-diagnostic; not a product endorsement.
</div>

<div class="grid cols-2 mb-3">
    <div class="card">
        <div class="card-h"><h3>Paste an INCI list</h3></div>
        <div class="card-b">
            <form asp-action="Ingredients" asp-route-id="@Model.Assessment.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="inci">Ingredients (comma- or line-separated)</label>
                    <textarea class="input" id="inci" name="inci" rows="10"
                              placeholder="Aqua, Glycerin, Niacinamide, Cetearyl Alcohol, Fragrance, ...">@Model.InciText</textarea>
                    <div class="hint">Copy the ingredient list straight from the product label or website.</div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    Analyze suitability
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-h"><h3>Suitability</h3><span class="badge badge-navy">Non-diagnostic</span></div>
        <div class="card-b">
            @if (Model.Result is null)
            {
                <div class="empty">
                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                    <p class="mt-2">Paste a list and analyze to see a suitability estimate for this profile.</p>
                </div>
            }
            else
            {
                <div class="flex between mb-2">
                    <span style="font-weight:600">Estimated suitability</span>
                    <span class="score-big" style="font-size:28px">@Model.Result.SuitabilityPercent<span style="font-size:13px;color:var(--muted)">/100</span></span>
                </div>
                <div class="meter"><span style="width:@Model.Result.SuitabilityPercent%"></span></div>
                <p class="hint mt-3">@Model.Result.Summary</p>
            }
        </div>
    </div>
</div>

@if (Model.Result is not null && Model.Result.Items.Count > 0)
{
    <div class="card mb-3">
        <div class="card-h"><h3>Per-ingredient verdict</h3><span class="badge badge-muted">@Model.Result.Items.Count recognized</span></div>
        <div class="card-b" style="padding:0">
            <table class="table">
                <thead><tr><th>Ingredient</th><th>Verdict</th><th>Note</th></tr></thead>
                <tbody>
                @foreach (var it in Model.Result.Items)
                {
                    <tr>
                        <td><strong>@it.Name</strong></td>
                        <td><span class="@BadgeClass(it.Verdict)">@it.Verdict</span></td>
                        <td class="muted">@it.Note</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card mb-3"><div class="card-b">
    <div class="disclaimer">
        For research and prototyping use only. Ingredient verdicts are curated, educational, and non-diagnostic;
        they do not account for full formulation, concentration, or personal sensitivities. Patch-test new products
        and consult a qualified professional for personal skin concerns.
    </div>
</div></div>
