@using MindAeonDermaAI.Web.Controllers
@model LookupsIndexViewModel
@{
    ViewData["Title"] = "Reference data";
}

<div class="page-head">
    <h1>Reference data</h1>
    <div class="spacer"></div>
    <span class="badge badge-muted">@Model.Items.Count value@(Model.Items.Count == 1 ? "" : "s")</span>
</div>

<div class="grid cols-3">
    <!-- Left: category list grouped by area. -->
    <div class="card">
        <div class="card-h"><h3>Categories</h3></div>
        <div class="card-b" style="padding:0">
            @foreach (var group in Model.Groups)
            {
                <div class="card-h" style="border-top:1px solid var(--line);"><h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)">@group.Title</h3></div>
                @foreach (var cat in group.Categories)
                {
                    var isActive = cat.Key == Model.SelectedEntity;
                    <a class="flex between items-center" asp-action="Index" asp-route-entity="@cat.Key"
                       style="padding:10px 16px;border-top:1px solid var(--line);text-decoration:none;color:var(--navy-800);@(isActive ? "background:var(--teal-50);font-weight:600" : "")">
                        <span>@cat.Label</span>
                        @if (isActive)
                        {
                            <span class="badge badge-teal">active</span>
                        }
                    </a>
                }
            }
        </div>
    </div>

    <!-- Right: values of the selected category + inline Smart-Select add. -->
    <div class="card" style="grid-column: span 2">
        <div class="card-h"><h3>@Model.SelectedLabel</h3></div>
        <div class="card-b">
            <div class="field mb-3">
                <label>Search or add a value</label>
                @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "quickAdd", Entity = Model.SelectedEntity, Placeholder = "Search or define a new value…" })
                <div class="muted mt-2" style="font-size:12.5px">
                    Type to search; if it doesn't exist, click ＋ Add to define it without leaving this screen.
                    New values become immediately available in every dropdown across the app.
                </div>
            </div>
        </div>
        <div class="card-b" style="padding:0">
            @if (Model.Items.Count == 0)
            {
                <div class="empty">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                    <p class="mt-2">No values defined for @Model.SelectedLabel yet. Use the box above to add one.</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Name</th><th>Description</th><th>Origin</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td>
                                @if (item.IsSystem)
                                {
                                    <span class="badge badge-muted">system</span>
                                }
                                else
                                {
                                    <span class="badge badge-teal">custom</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
