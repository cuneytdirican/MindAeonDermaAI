@using MindAeonDermaAI.Web.Controllers
@using MindAeonDermaAI.Core.Enums
@model AiProviderFormViewModel
@{
    ViewData["Title"] = "Add provider";
}

<div class="page-head">
    <h1>Add custom provider</h1>
    <div class="spacer"></div>
    <a class="btn btn-ghost" asp-action="Index">Back to providers</a>
</div>

<div class="grid cols-3">
    <div class="card" style="grid-column: span 2">
        <div class="card-h"><h3>New provider</h3></div>
        <div class="card-b">
            <div class="alert alert-info">
                Point at your own OpenAI-compatible LLM server (base URL ending in <code>/v1</code>, plus key and model),
                or register another hosted backend. For Anthropic/Claude use a base URL like
                <code>https://api.anthropic.com/v1</code>.
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-err" style="@(ViewData.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>

                <div class="row-2">
                    <div class="field">
                        <label asp-for="Name">Name</label>
                        <input asp-for="Name" class="input" placeholder="e.g. On-prem LLM" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ProviderType">Provider type</label>
                        <select asp-for="ProviderType" class="input">
                            <option value="@AiProviderType.OpenAiCompatible">OpenAI-compatible</option>
                            <option value="@AiProviderType.Anthropic">Anthropic</option>
                            <option value="@AiProviderType.Custom">Custom</option>
                        </select>
                        <div class="hint">Determines how requests are formatted.</div>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="BaseUrl">Base URL</label>
                    <input asp-for="BaseUrl" class="input" placeholder="https://your-server/v1" />
                    <span asp-validation-for="BaseUrl" class="text-danger"></span>
                    <div class="hint">OpenAI-compatible/custom endpoints use a <code>/v1</code> base URL; Anthropic uses <code>https://api.anthropic.com/v1</code>.</div>
                </div>

                <div class="row-2">
                    <div class="field">
                        <label asp-for="DefaultChatModel">Default chat model</label>
                        <input asp-for="DefaultChatModel" class="input" placeholder="e.g. llama-3.1-70b" />
                    </div>
                    <div class="field">
                        <label asp-for="DefaultVisionModel">Default vision model</label>
                        <input asp-for="DefaultVisionModel" class="input" placeholder="optional" />
                    </div>
                </div>

                <div class="field">
                    <label asp-for="ApiKey">API key</label>
                    <input asp-for="ApiKey" class="input" type="password" autocomplete="new-password"
                           placeholder="optional — leave blank if the endpoint needs none" />
                    <div class="hint">Encrypted at rest and never displayed again.</div>
                </div>

                <div class="field">
                    <label asp-for="ExtraHeadersJson">Extra headers (JSON)</label>
                    <textarea asp-for="ExtraHeadersJson" class="input" rows="3"
                              placeholder='{ "x-custom-header": "value" }'></textarea>
                    <div class="hint">Optional JSON object for custom auth headers.</div>
                </div>

                <div class="field">
                    <label class="flex items-center gap-2" style="font-weight:500;margin:0">
                        <input asp-for="IsEnabled" type="checkbox" /> Enabled
                    </label>
                </div>

                <div class="flex items-center gap-2">
                    <button class="btn btn-primary" type="submit">Add provider</button>
                    <a class="btn btn-ghost" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-h"><h3>About providers</h3></div>
        <div class="card-b">
            <p class="muted">
                MindAeon DermaAI ships with <strong>DeepSeek</strong> as the default plus templates for OpenAI,
                Anthropic (Claude), Google Gemini and Azure OpenAI. Add a custom provider here to bring your own
                OpenAI-compatible LLM server.
            </p>
            <div class="disclaimer mt-4">Keys are encrypted at rest. Research use only. Not a medical diagnosis.</div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
