@using MindAeonDermaAI.Web.Controllers
@using MindAeonDermaAI.Infrastructure.Identity
@model List<UserRow>
@{
    ViewData["Title"] = "Users";
}

<div class="page-head">
    <h1>Users</h1>
    <div class="spacer"></div>
    <a class="btn btn-primary" asp-action="Create">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        Add user
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        <p class="mt-2">No users yet.</p>
        <a class="btn btn-primary btn-sm" asp-action="Create">Add user</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-b" style="padding:0">
            <table class="table">
                <thead>
                <tr>
                    <th>Email</th>
                    <th>Full name</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    var current = u.Roles.FirstOrDefault();
                    <tr>
                        <td><strong>@u.Email</strong></td>
                        <td>@(string.IsNullOrEmpty(u.FullName) ? "—" : u.FullName)</td>
                        <td>
                            @if (u.Roles.Length == 0)
                            {
                                <span class="badge badge-muted">None</span>
                            }
                            else
                            {
                                foreach (var r in u.Roles)
                                {
                                    <span class="badge badge-navy">@r</span>
                                }
                            }
                        </td>
                        <td>
                            @if (u.LockedOut) { <span class="badge badge-danger">Disabled</span> }
                            else { <span class="badge badge-ok">Active</span> }
                        </td>
                        <td class="muted">@u.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="flex items-center gap-2" style="flex-wrap:wrap;justify-content:flex-end">
                                <form asp-action="SetRole" asp-route-id="@u.Id" method="post" class="flex items-center gap-2" style="display:inline-flex">
                                    <select name="role" class="input" style="width:auto;padding:4px 8px">
                                        @foreach (var role in AppRoles.All)
                                        {
                                            if (role == current)
                                            {
                                                <option value="@role" selected>@role</option>
                                            }
                                            else
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        }
                                    </select>
                                    <button class="btn btn-ghost btn-sm" type="submit">Set role</button>
                                </form>
                                <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post" style="display:inline">
                                    <button class="btn btn-ghost btn-sm" type="submit">@(u.LockedOut ? "Enable" : "Disable")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
