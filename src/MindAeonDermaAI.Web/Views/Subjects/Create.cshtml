@using MindAeonDermaAI.Web.Models
@model MindAeonDermaAI.Web.Controllers.SubjectFormViewModel
@{
    ViewData["Title"] = "New subject";
}

<div class="page-head">
    <h1>New subject</h1>
    <div class="spacer"></div>
    <a class="btn btn-ghost" asp-controller="Subjects" asp-action="Index">Cancel</a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>

    <div class="grid cols-2">
        <div class="card">
            <div class="card-h"><h3>Identity</h3></div>
            <div class="card-b">
                <div class="field">
                    <label>Display name <span class="muted">(optional)</span></label>
                    <input class="input" asp-for="DisplayName" maxlength="120" placeholder="Optional alias" />
                    <div class="hint">A code (e.g. SUBJ-0007) is generated automatically.</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-h"><h3>Anthropometrics</h3></div>
            <div class="card-b">
                <div class="row-3">
                    <div class="field">
                        <label>Age</label>
                        <input class="input" type="number" min="0" max="130" asp-for="Age" placeholder="Years" />
                    </div>
                    <div class="field">
                        <label>Height (cm)</label>
                        <input class="input" type="number" step="0.1" min="0" asp-for="HeightCm" placeholder="cm" />
                    </div>
                    <div class="field">
                        <label>Weight (kg)</label>
                        <input class="input" type="number" step="0.1" min="0" asp-for="WeightKg" placeholder="kg" />
                    </div>
                </div>
                <div class="hint">BMI is computed automatically from height and weight.</div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-h"><h3>Demographics</h3></div>
        <div class="card-b">
            <div class="grid cols-2">
                <div class="field">
                    <label>Sex</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "SexId", Entity = "sex", SelectedId = Model.SexId, SelectedName = Model.SexName, Placeholder = "Select sex" })
                </div>
                <div class="field">
                    <label>Skin type</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "SkinTypeId", Entity = "skinType", SelectedId = Model.SkinTypeId, SelectedName = Model.SkinTypeName, Placeholder = "Select skin type" })
                </div>
                <div class="field">
                    <label>Fitzpatrick type</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "FitzpatrickTypeId", Entity = "fitzpatrickType", SelectedId = Model.FitzpatrickTypeId, SelectedName = Model.FitzpatrickTypeName, Placeholder = "Select Fitzpatrick type" })
                </div>
                <div class="field">
                    <label>Menopause status</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "MenopauseStatusId", Entity = "menopauseStatus", SelectedId = Model.MenopauseStatusId, SelectedName = Model.MenopauseStatusName, Placeholder = "Select menopause status" })
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-h"><h3>Lifestyle</h3></div>
        <div class="card-b">
            <div class="grid cols-3">
                <div class="field">
                    <label>Smoking status</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "SmokingStatusId", Entity = "smokingStatus", SelectedId = Model.SmokingStatusId, SelectedName = Model.SmokingStatusName, Placeholder = "Select smoking status" })
                </div>
                <div class="field">
                    <label>Alcohol use</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "AlcoholUseId", Entity = "alcoholUse", SelectedId = Model.AlcoholUseId, SelectedName = Model.AlcoholUseName, Placeholder = "Select alcohol use" })
                </div>
                <div class="field">
                    <label>Sleep quality</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "SleepQualityId", Entity = "sleepQuality", SelectedId = Model.SleepQualityId, SelectedName = Model.SleepQualityName, Placeholder = "Select sleep quality" })
                </div>
                <div class="field">
                    <label>Stress level</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "StressLevelId", Entity = "stressLevel", SelectedId = Model.StressLevelId, SelectedName = Model.StressLevelName, Placeholder = "Select stress level" })
                </div>
                <div class="field">
                    <label>UV exposure level</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "UVExposureLevelId", Entity = "uvExposureLevel", SelectedId = Model.UVExposureLevelId, SelectedName = Model.UVExposureLevelName, Placeholder = "Select UV exposure" })
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-h"><h3>Prior aesthetic procedures <span class="muted">(optional, up to 3)</span></h3></div>
        <div class="card-b">
            <div class="grid cols-3">
                <div class="field">
                    <label>Procedure 1</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "AestheticProcedureId1", Entity = "aestheticProcedure", SelectedId = Model.AestheticProcedureId1, SelectedName = Model.AestheticProcedureName1, Placeholder = "Select procedure" })
                </div>
                <div class="field">
                    <label>Procedure 2</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "AestheticProcedureId2", Entity = "aestheticProcedure", SelectedId = Model.AestheticProcedureId2, SelectedName = Model.AestheticProcedureName2, Placeholder = "Select procedure" })
                </div>
                <div class="field">
                    <label>Procedure 3</label>
                    @await Html.PartialAsync("_SmartSelect", new SmartSelectModel { FieldName = "AestheticProcedureId3", Entity = "aestheticProcedure", SelectedId = Model.AestheticProcedureId3, SelectedName = Model.AestheticProcedureName3, Placeholder = "Select procedure" })
                </div>
            </div>
        </div>
    </div>

    <div class="flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7"/></svg>
            Create subject
        </button>
        <a class="btn btn-ghost" asp-controller="Subjects" asp-action="Index">Cancel</a>
    </div>
</form>
